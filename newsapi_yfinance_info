# ---------------- SENTIMENT MODEL ---------------- #
MODEL_NAME = "cardiffnlp/twitter-roberta-base-sentiment"
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME)
labels = ["negative", "neutral", "positive"]

def analyze_sentiment(text: str):
    if not text: return "neutral", 0.0
    inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=512)
    outputs = model(**inputs)
    probs = F.softmax(outputs.logits, dim=1).detach().numpy()[0]
    idx = probs.argmax()
    return labels[idx], float(probs[idx])

def add_sentiment(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty: return df
    sentiments, scores = [], []
    for _, row in df.iterrows():
        text_content = f"{row['title']} {row['description']}"
        label, score = analyze_sentiment(text_content)
        sentiments.append(label)
        scores.append(score)
    df["sentiment"] = sentiments
    df["sentiment_score"] = scores
    return df

# ---------------- NEWS FUNCTIONS ---------------- #
def fetch_news(company_name: str) -> pd.DataFrame:
    from_date = (datetime.now(timezone.utc) - timedelta(days=NEWS_LOOKBACK_DAYS)).strftime("%Y-%m-%d")
    params = {
        "q": company_name,
        "from": from_date,
        "sortBy": "publishedAt",
        "language": "en",
        "pageSize": 20, # Reduced for speed during testing
        "apiKey": NEWS_API_KEY,
    }
    try:
        resp = requests.get("https://newsapi.org/v2/everything", params=params, timeout=15)
        resp.raise_for_status()
        articles = resp.json().get("articles", [])
    except Exception as e:
        print(f"Error fetching news for {company_name}: {e}")
        return pd.DataFrame()

    rows = []
    for art in articles:
        pub_ts = pd.to_datetime(art.get("publishedAt"))
        url = art.get("url", "")
        # Create a truly unique ID based on URL to avoid PK collisions
        unique_id = hashlib.md5(url.encode()).hexdigest()

        rows.append({
            "article_id": unique_id,
            "company": company_name,
            "title": (art.get("title") or "").strip(),
            "description": (art.get("description") or "").strip(),
            "source": art.get("source", {}).get("name", ""),
            "published_at": pub_ts,
            "published_date": pub_ts.date(),
            "url": url
        })

    df = pd.DataFrame(rows)
    df = df.drop_duplicates(subset=["url"])
    return add_sentiment(df)

def fetch_all_news():
    frames = []
    for company in COMPANIES:
        print(f"--- Fetching news: {company} ---")
        df = fetch_news(company)
        if not df.empty:
            frames.append(df)
    return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()

# ---------------- STOCK FUNCTIONS ---------------- #
def fetch_stock_prices_yf(ticker: str) -> pd.DataFrame:
    end = datetime.now().date()
    start = end - timedelta(days=NEWS_LOOKBACK_DAYS + 7)
    
    data = yf.download(ticker, start=str(start), end=str(end), progress=False)
    if data.empty: return pd.DataFrame()

    # Handle MultiIndex if present
    if isinstance(data.columns, pd.MultiIndex):
        data.columns = data.columns.get_level_values(0)

    df = data.reset_index()
    df.columns = [c.lower().replace(" ", "_") for c in df.columns]
    
    df = df.rename(columns={"date": "date", "adj_close": "adjusted_close"})
    if "adjusted_close" not in df.columns:
        df["adjusted_close"] = df["close"]
        
    df["date"] = pd.to_datetime(df["date"]).dt.date
    df["symbol"] = ticker
    
    return df[["date", "open", "high", "low", "close", "adjusted_close", "volume", "symbol"]]

def fetch_all_stocks():
    frames = []
    for company, ticker in COMPANY_TICKERS.items():
        print(f"--- Fetching stock: {ticker} ---")
        df = fetch_stock_prices_yf(ticker)
        if not df.empty:
            df["company"] = company
            frames.append(df)
        time.sleep(0.5)
    return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()

# ---------------- LOAD FUNCTION ---------------- #
def load_to_postgres(news_df, stock_df):
    print("\n" + "="*30)
    print("DATABASE LOAD SECTION")
    print("="*30)
    
    # Use 'begin' context manager for automatic commit
    with engine.begin() as conn:
        if not news_df.empty:
            print(f"Attempting to load {len(news_df)} news rows...")
            news_df.to_sql("news", conn, if_exists="replace", index=False)
            print("Successfully loaded news.")
        else:
            print("News DataFrame is empty. Skipping.")

        if not stock_df.empty:
            print(f"Attempting to load {len(stock_df)} stock rows...")
            stock_df.to_sql("stocks", conn, if_exists="replace", index=False)
            print("Successfully loaded stocks.")
        else:
            print("Stock DataFrame is empty. Skipping.")

